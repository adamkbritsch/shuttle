# Copy to .env and fill in. .env is gitignored and must stay that way.

# Bearer token for the HTTP API that Shuttle talks to. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# With no token the HTTP API does not start at all: it writes into your media
# volumes, so it is never exposed unauthenticated.
RELAY_API_TOKEN=

# Optional: credentials for the built-in FTP front end, which exists only so
# FileZilla can drive the same relay. Leave blank if you only use Shuttle.
FTP_USER=
FTP_PASS=

# --- where the relay listens -------------------------------------------------
# Use a private/VPN address, never 0.0.0.0: this API writes into your volumes.
RELAY_API_BIND=100.64.0.1
FTP_BIND_ADDR=100.64.0.1

# --- destinations ------------------------------------------------------------
# A host directory to copy INTO, and the name it appears under in the app.
DEST_1=/volume1/Media
DEST_1_NAME=Media

# Ownership the relay writes as. Match your existing media volumes.
PUID=1000
PGID=1000

# --- optional: FileZilla front end ------------------------------------------
# Only needed if you also want to drive the relay from FileZilla, which needs a
# real filesystem to list. Shuttle does not: it reads the seedbox over rclone.
# Point this at an rclone FUSE mount of your seedbox.
# SEEDBOX_MOUNT=/home/you/mounts/seedbox
